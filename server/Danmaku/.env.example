# 直播弹幕服务配置示例
# 复制为 .env 后按需修改，系统环境变量优先级高于本文件

# 服务监听地址，0.0.0.0 表示监听所有网卡
HOST=0.0.0.0

# HTTP / WebSocket 端口
PORT=3002

# 允许的网页来源，多个用英文逗号分隔；留空表示允许所有来源
ALLOWED_ORIGINS=https://www.qyserver.top,http://localhost:8080

# 单条弹幕最大字符数
MAX_TEXT_LENGTH=80

# 同一连接两次发送的最小间隔，单位毫秒
MESSAGE_COOLDOWN_MS=1200

# 频率限制统计窗口，单位毫秒
RATE_WINDOW_MS=10000

# 单个统计窗口内最多发送条数
RATE_WINDOW_LIMIT=8

# WebSocket 心跳间隔，单位毫秒
HEARTBEAT_INTERVAL_MS=30000

# 单条 WebSocket 消息最大字节数
MAX_PAYLOAD_BYTES=4096

# 额外违禁词，多个用英文逗号分隔；留空表示只使用违禁词文件
BANNED_WORDS=

# 违禁词文件路径，相对路径以 server/Danmaku 为基准
BANNED_WORDS_FILE=banned-words.json
